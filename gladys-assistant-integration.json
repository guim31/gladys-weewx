  "scene_actions": [
    {
      "key": "current_conditions",
      "timeout_seconds": 10,
      "label": {
        "en": "WeeWX: current conditions",
        "fr": "WeeWX : conditions actuelles",
        "de": "WeeWX: Aktuelle Bedingungen",
        "es": "WeeWX: condiciones actuales"
      },
      "description": {
        "en": "The latest measurements of the station, as a sentence ready for a message, with their numbers.",
        "fr": "Les dernières mesures de la station, en une phrase prête pour un message, avec leurs valeurs.",
        "de": "Die letzten Messwerte der Station, als Satz für eine Nachricht, mit ihren Werten.",
        "es": "Las últimas mediciones de la estación, en una frase lista para un mensaje, con sus valores."
      },
      "outputs": [
        {
          "key": "summary",
          "type": "string",
          "label": {
            "en": "Conditions sentence",
            "fr": "Phrase des conditions",
            "de": "Satz der Bedingungen",
            "es": "Frase de las condiciones"
          }
        },
        {
          "key": "temperature",
          "type": "number",
          "label": {
            "en": "Temperature (°C)",
            "fr": "Température (°C)",
            "de": "Temperatur (°C)",
            "es": "Temperatura (°C)"
          }
        },
        {
          "key": "humidity",
          "type": "number",
          "label": {
            "en": "Humidity (%)",
            "fr": "Humidité (%)",
            "de": "Luftfeuchtigkeit (%)",
            "es": "Humedad (%)"
          }
        },
        {
          "key": "wind_speed",
          "type": "number",
          "label": {
            "en": "Average wind (km/h)",
            "fr": "Vent moyen (km/h)",
            "de": "Mittlerer Wind (km/h)",
            "es": "Viento medio (km/h)"
          }
        },
        {
          "key": "wind_gust",
          "type": "number",
          "label": {
            "en": "Wind gusts (km/h)",
            "fr": "Rafales (km/h)",
            "de": "Windböen (km/h)",
            "es": "Ráfagas (km/h)"
          }
        },
        {
          "key": "rain_today",
          "type": "number",
          "label": {
            "en": "Rain today (mm)",
            "fr": "Pluie du jour (mm)",
            "de": "Regen heute (mm)",
            "es": "Lluvia de hoy (mm)"
          }
