{
  "manifest_version": 1,
  "type": "device",
  "name": "WeeWX",
  "description": {
    "en": "Your WeeWX weather station in Gladys, whatever its brand: live measurements over MQTT or HTTP.",
    "fr": "Votre station météo WeeWX dans Gladys, quelle que soit sa marque : mesures en direct, MQTT ou HTTP.",
    "de": "Deine WeeWX-Wetterstation in Gladys, egal welche Marke: Live-Messwerte über MQTT oder HTTP.",
    "es": "Su estación meteorológica WeeWX en Gladys, sea cual sea su marca: datos en directo, MQTT o HTTP."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-weewx:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-weewx/main/cover.png",
  "categories": ["environment"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Connect WeeWX",
        "fr": "Connecter WeeWX",
        "de": "WeeWX verbinden",
        "es": "Conectar WeeWX"
      },
      "description": {
        "en": "Fill in at least one source. MQTT (weewx-mqtt extension) is live, every few seconds. HTTP reads the JSON file of a skin (weewx-json or Belchertown), refreshed by WeeWX every few minutes.",
        "fr": "Renseignez au moins une source. MQTT (extension weewx-mqtt) est en direct, toutes les quelques secondes. HTTP lit le fichier JSON d'un skin (weewx-json ou Belchertown), que WeeWX régénère toutes les quelques minutes.",
        "de": "Gib mindestens eine Quelle an. MQTT (Erweiterung weewx-mqtt) liefert live, alle paar Sekunden. HTTP liest die JSON-Datei eines Skins (weewx-json oder Belchertown), die WeeWX alle paar Minuten neu erzeugt.",
        "es": "Indique al menos una fuente. MQTT (extensión weewx-mqtt) es en directo, cada pocos segundos. HTTP lee el archivo JSON de un skin (weewx-json o Belchertown), que WeeWX regenera cada pocos minutos."
      },
      "links": [
        {
          "url": "https://github.com/matthewwall/weewx-mqtt",
          "label": {
            "en": "weewx-mqtt extension",
            "fr": "Extension weewx-mqtt",
            "de": "Erweiterung weewx-mqtt",
            "es": "Extensión weewx-mqtt"
          }
        },
        {
          "url": "https://github.com/teeks99/weewx-json",
          "label": {
            "en": "weewx-json skin",
            "fr": "Skin weewx-json",
            "de": "Skin weewx-json",
            "es": "Skin weewx-json"
          }
        }
      ]
    },
    {
      "key": "mqtt_url",
      "type": "string",
      "label": {
        "en": "MQTT broker",
        "fr": "Broker MQTT",
        "de": "MQTT-Broker",
        "es": "Broker MQTT"
      },
      "description": {
        "en": "The broker weewx-mqtt publishes to. Leave empty to use HTTP only.",
        "fr": "Le broker sur lequel publie weewx-mqtt. Laissez vide pour n'utiliser que HTTP.",
        "de": "Der Broker, an den weewx-mqtt sendet. Leer lassen, um nur HTTP zu nutzen.",
        "es": "El broker en el que publica weewx-mqtt. Déjelo vacío para usar solo HTTP."
      },
      "placeholder": {
        "en": "e.g. mqtt://weewx.local:1883",
        "fr": "ex. mqtt://weewx.local:1883",
        "de": "z. B. mqtt://weewx.local:1883",
        "es": "p. ej. mqtt://weewx.local:1883"
      }
    },
    {
      "key": "mqtt_username",
      "type": "string",
      "label": {
        "en": "MQTT user name",
        "fr": "Utilisateur MQTT",
        "de": "MQTT-Benutzername",
        "es": "Usuario MQTT"
      },
      "description": {
        "en": "Only if the broker requires it.",
        "fr": "Seulement si le broker l'exige.",
        "de": "Nur wenn der Broker es verlangt.",
        "es": "Solo si el broker lo exige."
      }
    },
    {
      "key": "mqtt_password",
      "type": "secret",
      "label": {
        "en": "MQTT password",
        "fr": "Mot de passe MQTT",
        "de": "MQTT-Passwort",
        "es": "Contraseña MQTT"
      }
    },
    {
      "key": "mqtt_topic",
      "type": "string",
      "default": "weather/loop",
      "label": {
        "en": "MQTT topic",
        "fr": "Sujet MQTT",
        "de": "MQTT-Topic",
        "es": "Tema MQTT"
      },
      "description": {
        "en": "The `topic` of weewx-mqtt followed by /loop: weather/loop by default.",
        "fr": "Le `topic` de weewx-mqtt suivi de /loop : weather/loop par défaut.",
        "de": "Das `topic` von weewx-mqtt gefolgt von /loop: standardmäßig weather/loop.",
        "es": "El `topic` de weewx-mqtt seguido de /loop: weather/loop por defecto."
      },
      "placeholder": {
        "en": "weather/loop",
        "fr": "weather/loop",
        "de": "weather/loop",
        "es": "weather/loop"
      }
    },
    {
      "key": "http_url",
      "type": "string",
      "label": {
        "en": "JSON file address",
        "fr": "Adresse du fichier JSON",
        "de": "Adresse der JSON-Datei",
        "es": "Dirección del archivo JSON"
      },
      "description": {
        "en": "weewx.json (weewx-json skin) or weewx_data.json (Belchertown skin), as served by the web server of WeeWX. Leave empty to use MQTT only.",
        "fr": "weewx.json (skin weewx-json) ou weewx_data.json (skin Belchertown), tel que le sert le serveur web de WeeWX. Laissez vide pour n'utiliser que MQTT.",
        "de": "weewx.json (Skin weewx-json) oder weewx_data.json (Skin Belchertown), wie sie der Webserver von WeeWX ausliefert. Leer lassen, um nur MQTT zu nutzen.",
        "es": "weewx.json (skin weewx-json) o weewx_data.json (skin Belchertown), tal como lo sirve el servidor web de WeeWX. Déjelo vacío para usar solo MQTT."
      },
      "placeholder": {
        "en": "e.g. http://weewx.local/weewx/json/weewx.json",
        "fr": "ex. http://weewx.local/weewx/json/weewx.json",
        "de": "z. B. http://weewx.local/weewx/json/weewx.json",
        "es": "p. ej. http://weewx.local/weewx/json/weewx.json"
      }
    },
    {
      "key": "http_interval",
      "type": "number",
      "default": 60,
      "min": 15,
      "max": 3600,
      "label": {
        "en": "File reading interval (s)",
        "fr": "Intervalle de lecture du fichier (s)",
        "de": "Leseintervall der Datei (s)",
        "es": "Intervalo de lectura del archivo (s)"
      },
      "description": {
        "en": "WeeWX rewrites the file once per archive interval (5 minutes by default).",
        "fr": "WeeWX réécrit le fichier une fois par intervalle d'archive (5 minutes par défaut).",
        "de": "WeeWX schreibt die Datei einmal pro Archivintervall neu (standardmäßig 5 Minuten).",
        "es": "WeeWX reescribe el archivo una vez por intervalo de archivo (5 minutos por defecto)."
      }
    },
    {
      "key": "language",
      "type": "select",
      "default": "fr",
      "label": {
        "en": "Language of the texts",
        "fr": "Langue des textes",
        "de": "Sprache der Texte",
        "es": "Idioma de los textos"
      },
      "description": {
        "en": "Feature names of the station when it is added, scene sentences and action messages.",
        "fr": "Noms des fonctionnalités de la station à son ajout, phrases des scènes et messages des actions.",
        "de": "Namen der Funktionen der Station beim Hinzufügen, Szenen-Sätze und Meldungen der Aktionen.",
        "es": "Nombres de las funciones de la estación al añadirla, frases de escenas y mensajes de las acciones."
      },
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "check_sources",
      "timeout_seconds": 20,
      "label": {
        "en": "Check the sources",
        "fr": "Vérifier les sources",
        "de": "Quellen prüfen",
        "es": "Comprobar las fuentes"
      },
      "description": {
        "en": "Tells whether the broker and the JSON file answer, and what WeeWX sent last.",
        "fr": "Indique si le broker et le fichier JSON répondent, et ce que WeeWX a envoyé en dernier.",
        "de": "Zeigt, ob Broker und JSON-Datei antworten und was WeeWX zuletzt gesendet hat.",
        "es": "Indica si el broker y el archivo JSON responden, y lo último que envió WeeWX."
      }
    }
  ],
  "scene_triggers": [
    {
      "key": "rain_started",
      "label": {
        "en": "WeeWX: it starts raining",
        "fr": "WeeWX : il commence à pleuvoir",
        "de": "WeeWX: Es beginnt zu regnen",
        "es": "WeeWX: empieza a llover"
      },
      "description": {
        "en": "The station measures rain after at least 30 minutes without any. Fires once per rain episode.",
        "fr": "La station mesure de la pluie après au moins 30 minutes sans. Se déclenche une fois par épisode de pluie.",
        "de": "Die Station misst Regen nach mindestens 30 Minuten ohne. Löst einmal pro Regenepisode aus.",
        "es": "La estación mide lluvia tras al menos 30 minutos sin ella. Se activa una vez por episodio de lluvia."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Station",
            "fr": "Station",
            "de": "Station",
            "es": "Estación"
          }
        }
      ],
      "variables": [
        {
          "key": "station",
          "type": "string",
          "label": {
            "en": "Station name",
            "fr": "Nom de la station",
            "de": "Name der Station",
            "es": "Nombre de la estación"
          }
        }
      ]
    },
    {
      "key": "rain_stopped",
      "label": {
        "en": "WeeWX: the rain stops",
        "fr": "WeeWX : la pluie s'arrête",
        "de": "WeeWX: Der Regen hört auf",
        "es": "WeeWX: deja de llover"
      },
      "description": {
        "en": "No rain for the chosen time after rain. Fires once per dry spell.",
        "fr": "Plus de pluie depuis la durée choisie, après de la pluie. Se déclenche une fois par accalmie.",
        "de": "Kein Regen mehr seit der gewählten Dauer, nach Regen. Löst einmal pro Trockenphase aus.",
        "es": "Sin lluvia durante el tiempo elegido, tras haber llovido. Se activa una vez por periodo seco."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Station",
            "fr": "Station",
            "de": "Station",
            "es": "Estación"
          }
        },
        {
          "key": "after_minutes",
          "type": "select",
          "required": true,
          "default": "30",
          "label": {
            "en": "Dry for",
            "fr": "Sans pluie depuis",
            "de": "Trocken seit",
            "es": "Sin lluvia desde hace"
          },
          "options": [
            {
              "value": "15",
              "label": {
                "en": "15 minutes",
                "fr": "15 minutes",
                "de": "15 Minuten",
                "es": "15 minutos"
              }
            },
            {
              "value": "30",
              "label": {
                "en": "30 minutes",
                "fr": "30 minutes",
                "de": "30 Minuten",
                "es": "30 minutos"
              }
            },
            {
              "value": "60",
              "label": {
                "en": "60 minutes",
                "fr": "60 minutes",
                "de": "60 Minuten",
                "es": "60 minutos"
              }
            },
            {
              "value": "120",
              "label": {
                "en": "120 minutes",
                "fr": "120 minutes",
                "de": "120 Minuten",
                "es": "120 minutos"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "rain_today_mm",
          "type": "number",
          "label": {
            "en": "Rain today (mm)",
            "fr": "Pluie du jour (mm)",
            "de": "Regen heute (mm)",
            "es": "Lluvia de hoy (mm)"
          }
        },
        {
          "key": "station",
          "type": "string",
          "label": {
            "en": "Station name",
            "fr": "Nom de la station",
            "de": "Name der Station",
            "es": "Nombre de la estación"
          }
        }
      ]
    },
    {
      "key": "gust_above",
      "label": {
        "en": "WeeWX: strong wind gust",
        "fr": "WeeWX : rafale de vent forte",
        "de": "WeeWX: Starke Windböe",
        "es": "WeeWX: ráfaga de viento fuerte"
      },
      "description": {
        "en": "A gust above the chosen speed, the first one for 30 minutes.",
        "fr": "Une rafale au-delà de la vitesse choisie, la première depuis 30 minutes.",
        "de": "Eine Böe über der gewählten Geschwindigkeit, die erste seit 30 Minuten.",
